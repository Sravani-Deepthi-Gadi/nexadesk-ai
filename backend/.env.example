# Copy to .env and fill in. NEVER commit .env.
#
# Leave ANTHROPIC_API_KEY genuinely EMPTY if you have no key yet. Placeholder
# text passes the "is it set?" check and then fails with a 401 from Anthropic;
# empty gives the clean "assistant not configured" response instead.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
DATABASE_URL=sqlite:///./data/nexadesk.db
CORS_ORIGINS=http://localhost:5173

# Auth. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Optional bootstrap admin (leave blank and use scripts/create_admin.py instead)
ADMIN_EMAIL=
ADMIN_PASSWORD=
